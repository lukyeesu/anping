{
  "headers": [
    {
      "source": "/anping-card-agent.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"anping-card-agent.apk\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/.*|.*\\.apk).*)", "destination": "/index.html" }
  ]
}
